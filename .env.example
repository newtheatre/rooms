# Copy to `.env` (gitignored) and fill in. See README.md §Quick start.

# The estate-wide session seal. Every *.newtheatre.org.uk app must use the SAME
# value or sessions sealed by one app cannot be read by another.
#
# In production this is NOT set here: it lives in the account Secrets Store and
# is bound in as SESSION_PASSWORD (nuxt.config.ts → secrets_store_secrets),
# then copied into runtimeConfig by server/plugins/0.secrets-store.ts.
# Setting it as a worker secret in production BREAKS sealing — a leftover
# secret of this name takes priority over the store binding.
#
# Locally, nuxt-auth-utils generates one and appends it to .env on first run.
# Minimum 32 characters.
NUXT_SESSION_PASSWORD=

# Service token for server-to-server calls to the auth service (shadow accounts)
# and the bearer for inbound GDPR hooks. Ask the ITM for one (`nnt_svc_…`).
#
# The NUXT_ prefix is load-bearing: Nuxt only maps NUXT_* env onto
# runtimeConfig, so a secret named AUTH_SERVICE_TOKEN is silently ignored.
NUXT_AUTH_SERVICE_TOKEN=

# Resend, for booking notification email. Optional: without it the client is
# never constructed and email degrades to a logged no-op rather than failing.
# Read directly from process.env (not runtimeConfig), unlike the other apps.
RESEND_API_KEY=

# The From address for outgoing mail, e.g. rooms@newtheatre.org.uk
EMAIL=
